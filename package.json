{
  "name": "eventos",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter @eventos/backend dev",
    "dev:frontend": "bun run --filter @eventos/frontend dev",
    "build": "bun run --filter '*' build",
    "db:migrate": "bun run --filter @eventos/backend migration:run",
    "db:revert": "bun run --filter @eventos/backend migration:revert",
    "db:init": "bun run --filter @eventos/backend db:init",
    "db:seed": "bun run --filter @eventos/backend seed",
    "db:reset": "bun run --filter @eventos/backend db:reset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2"
  }
}